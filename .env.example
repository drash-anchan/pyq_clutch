# ========================================================
# PYQ VAULT // ENVIRONMENT VARIABLES (OPTIONAL)
# ========================================================

# Umami Silent Background Analytics (Frontend tracking script)
# Website ID obtained from your Umami Cloud dashboard (e.g. 123e4567-e89b-12d3-a456-426614174000)
VITE_UMAMI_WEBSITE_ID=

# Umami Script URL (Defaults to official Umami Cloud script)
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# NOTE: Private API Key (UMAMI_API_KEY) must NEVER be placed in this file or exposed to the browser.
# Configure UMAMI_API_KEY and UMAMI_WEBSITE_ID exclusively as GitHub Actions Secrets
# in GitHub Repository -> Settings -> Secrets and variables -> Actions.
